# Raw archive and extraction metadata
/data/raw/*.zip
/data/raw/download-*.tmp
/data/raw/download-*.part
**/__MACOSX/

# Python and notebooks
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/

# Local training outputs and checkpoints. Keep only the compact TXT histories.
/artifacts/*
!/artifacts/training_progress_5block_small_history.txt
!/artifacts/complex_cnn_5block_small_seed42/
/artifacts/complex_cnn_5block_small_seed42/*
!/artifacts/complex_cnn_5block_small_seed42/progress_history.txt
!/artifacts/complex_cnn_5block_small_seed43/
/artifacts/complex_cnn_5block_small_seed43/*
!/artifacts/complex_cnn_5block_small_seed43/progress_history.txt

# Generated datasets (keep folder structure)
/data/processed/*
!/data/processed/.gitkeep
/data/train/*
!/data/train/.gitkeep
/data/val/*
!/data/val/.gitkeep
/data/test/*
!/data/test/.gitkeep
